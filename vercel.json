{
  "version": 2,
  "name": "freqfind",
  "buildCommand": "node scripts/write-config.js",
  "outputDirectory": ".",
  "installCommand": "",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://freqfind-api.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
